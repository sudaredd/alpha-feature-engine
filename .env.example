# Alpha Feature Engine Environment Template
# Copy this file to .env or use run_local.sh (both are git-ignored)

# Alpha Vantage API Key (Free tier: https://www.alphavantage.co/support/#api-key)
ALPHAVANTAGE_API_KEY=your_alphavantage_key_here

# Alpaca Markets API Credentials (Paper or Live: https://app.alpaca.markets)
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_API_SECRET=your_alpaca_secret_here

# Google Gemini API Key (for LangGraph AI Trading Agent)
GOOGLE_API_KEY=your_gemini_api_key_here
